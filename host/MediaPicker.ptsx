// The admin's media library as the editor's media seam: uploads go to `/media/upload`,
// picking opens a grid of the library's files of one kind (through `media.list`, as the
// person signed in) and resolves with the one clicked.
import { Publr } from "publr-jsx";
import { mount } from "publr/dom";
import { component } from "publr-jsx";
import { send } from "publr/operations";
import { Button } from "../../ui/src/components/Button/Button.ptsx";
import { Input } from "../../ui/src/components/Input/Input.ptsx";
import { Text } from "../../ui/src/components/Text/Text.ptsx";
import type { MediaHost } from "../shell/session";

type Item = { id: string; title: string; filename: string; family: string; width?: number | null; height?: number | null; key: string };
type Picked = { src: string; alt: string; width: string; height: string };

export const state = Publr.reactive({
  open: false,
  loading: false,
  error: "",
  kind: "image",
  search: "",
  items: [] as { id: string; title: string; src: string; thumb: string; family: string }[],
});

let found: Item[] = [];
let settle: ((picked: Picked | null) => void) | null = null;
let mounted = false;

const csrf = () => document.querySelector<HTMLMetaElement>('meta[name="publr-csrf"]')?.content ?? "";

const asPicked = (item: Item): Picked => ({
  src: `/media/${item.key}`,
  alt: item.title || item.filename.replace(/\.[^.]+$/, ""),
  width: item.width ? String(item.width) : "",
  height: item.height ? String(item.height) : "",
});

async function load(): Promise<void> {
  state.loading = true;
  state.error = "";
  try {
    const kind = state.kind === "file" ? "" : state.kind;
    const answer = (await send("media.list", { kind, search: state.search, limit: 60 })) as { items: Item[] };
    found = answer.items;
    state.items = found.map((item) => ({
      id: item.id,
      title: item.title || item.filename,
      src: `/media/${item.key}`,
      thumb: item.family === "image" ? `/media/${item.key}?w=240&h=240&fit=cover` : "",
      family: item.family,
    }));
  } catch (error) {
    state.error = error instanceof Error ? error.message : String(error);
  }
  state.loading = false;
}

export function choose(id: string): void {
  const item = found.find((candidate) => candidate.id === id);
  close(item ? asPicked(item) : null);
}

export function close(picked: Picked | null = null): void {
  state.open = false;
  settle?.(picked);
  settle = null;
}

export function search(value: string): void {
  state.search = value;
  void load();
}

function MediaPicker() {
  return (
    <div>
      {state.open && (
        <div data-media-picker class="fixed inset-0 z-[1000] grid place-items-center bg-black/40 p-6" onPointerDown={(event: PointerEvent) => event.target === event.currentTarget && close()}>
          <div role="dialog" aria-label="Media library" class="flex max-h-full w-full max-w-4xl flex-col gap-3 rounded-lg bg-card p-4 shadow-xl">
            <div class="flex items-center gap-2">
              <Text variant="heading-sm">Media library</Text>
              <div class="flex-1"></div>
              <Input size="sm" placeholder="Search" value={state.search} onInput={(event: Event) => search((event.target as HTMLInputElement).value)} />
              <Button hierarchy="tertiary" size="sm" onClick={() => close()}>
                Cancel
              </Button>
            </div>
            {state.error && <Text variant="body-sm" tone="destructive">{state.error}</Text>}
            {state.loading && <Text variant="body-sm" tone="muted">Loading…</Text>}
            {!state.loading && state.items.length === 0 && <Text variant="body-sm" tone="muted">Nothing here yet. Upload from the block's settings.</Text>}
            <div class="grid min-h-0 grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-2 overflow-auto">
              {state.items.map((item) => (
                <button type="button" data-media-item={item.id} class="grid gap-1 rounded-md border border-border p-1 text-left text-2xs hover:border-ring" onClick={() => choose(item.id)}>
                  {item.thumb ? <img src={item.thumb} alt="" class="aspect-square w-full rounded-sm object-cover" /> : <span class="grid aspect-square place-items-center rounded-sm bg-muted uppercase">{item.family}</span>}
                  <span class="truncate">{item.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function ensureMounted(): void {
  if (mounted) return;
  mounted = true;
  const host = document.createElement("div");
  host.setAttribute("data-media-picker-host", "");
  document.body.append(host);
  mount(host, () => component(MediaPicker, {}), {});
}

export function adminMedia(): MediaHost {
  return {
    async upload(file) {
      const response = await fetch(`/media/upload?filename=${encodeURIComponent(file.name)}`, {
        method: "POST",
        credentials: "same-origin",
        headers: { "X-Csrf-Token": csrf(), "Content-Type": file.type || "application/octet-stream" },
        body: file,
      });
      if (!response.ok) throw new Error(`Upload refused (${response.status})`);
      return asPicked((await response.json()) as Item);
    },
    pick(kind) {
      ensureMounted();
      settle?.(null);
      state.kind = kind;
      state.search = "";
      state.open = true;
      void load();
      return new Promise((resolve) => (settle = resolve));
    },
  };
}
