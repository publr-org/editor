// Primitive blocks: the starting recipe of each content block. The left panel lists every
// block the inserter offers; the open one is a real editor on its default document, with
// the editor's own inline chrome and block inspector. Save default keeps it in the
// design system (`blockDefaults`).
import { EntryButton } from "../../../ui/src/components/EntryButton/EntryButton.ptsx";
import { GlyphTile } from "../../../ui/src/components/GlyphTile/GlyphTile.ptsx";
import { Icon } from "../../../ui/src/components/Icon/Icon.ptsx";
import { Toast } from "../../../ui/src/components/Toast/Toast.ptsx";
import { state } from "../Builder.ptsx";
import { blockEditorInto, selectBlock } from "./actions";

export function BlocksPage() {
  return (
    <div class="relative flex min-h-0 flex-1 flex-col overflow-hidden" data-design-page="Blocks">
      <div class="min-h-0 w-full flex-1" data-design-default-editor ref={(element: Element | null) => blockEditorInto(element)}></div>
      {state.blockToast && (
        <div class="pointer-events-none absolute bottom-6 left-1/2 z-30 -translate-x-1/2" data-block-default-toast>
          <Toast>{state.blockToast}</Toast>
        </div>
      )}
    </div>
  );
}

/** The left panel's list while this page is open: every block, with its category. */
export function BlocksNav() {
  return (
    <div class="min-h-0 flex-1 overflow-y-auto p-2" data-design-controls="components">
      {state.blockItems.map((block) => (
        <div data-block-type={block.type}>
          <EntryButton
            title={block.label}
            subtitle={block.category}
            pressed={block.selected}
            onClick={() => selectBlock(block.type)}
            glyph={
              block.icon ? (
                <GlyphTile size="md" framed>
                  <Icon name={block.icon} size="sm" />
                </GlyphTile>
              ) : (
                <GlyphTile size="md" glyph={block.letter} framed />
              )
            }
          />
        </div>
      ))}
    </div>
  );
}
