// Patterns: the app's reusable compositions, each a live preview drawn with the working
// design system. Pick one to edit its library design in the full editor; the left panel
// narrows them by category.
import { Publr } from "publr-jsx";
import { SidebarNavEyebrow } from "../../../ui/src/components/Sidebar/SidebarNavEyebrow.ptsx";
import { SidebarNavItem } from "../../../ui/src/components/Sidebar/SidebarNavItem.ptsx";
import { Icon } from "../../../ui/src/components/Icon/Icon.ptsx";
import { Notice } from "../../../ui/src/components/Notice/Notice.ptsx";
import { PreviewCard } from "../../../ui/src/components/PreviewCard/PreviewCard.ptsx";
import { Text } from "../../../ui/src/components/Text/Text.ptsx";
import { state } from "../Builder.ptsx";
import { PageHead } from "../parts/PageHead.ptsx";
import { cardKeys, editPattern, selectPatternCategory } from "./actions";
import { previewInto } from "./previews";

export function PatternsPage() {
  return (
    <div class="w-full p-8 max-lg:p-5" data-design-page="Patterns">
      <PageHead compact crumb={Publr.t("Patterns / Library")} title={Publr.t("Compositions with range")} description={Publr.t("Structure stays stable; the selected context flows through every primitive inside it.")} />
      {state.libraryError && <Notice classes="mb-5">{state.libraryError}</Notice>}
      <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-5" data-design-pattern-grid>
        {state.patternItems.map((pattern) => (
          <PreviewCard
            label={pattern.label}
            onClick={(event: MouseEvent) => editPattern(pattern.name, event)}
            onKeyDown={(event: KeyboardEvent) => cardKeys(event, (opened: Event) => editPattern(pattern.name, opened))}
          >
            <div data-pattern-preview={pattern.name} class="w-full" ref={(element: Element | null) => previewInto(element, pattern.html)}></div>
          </PreviewCard>
        ))}
      </div>
    </div>
  );
}

/** The left panel's list while this page is open: the categories, with counts. */
export function PatternsNav() {
  return (
    <div class="min-h-0 flex-1 overflow-y-auto px-3 pb-4" data-design-controls="patterns">
      <SidebarNavEyebrow>{Publr.t("Categories")}</SidebarNavEyebrow>
      {state.patternCategories.map((category) => (
        <div data-design-pattern-category={category.name}>
          <SidebarNavItem active={category.selected} onClick={() => selectPatternCategory(category.name)}>
            <Icon name="pattern" size="sm" classes="shrink-0" />
            <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
              {category.name}
            </Text>
            <Text as="span" variant="body-sm" tone="muted" classes="shrink-0 tabular-nums">
              {String(category.count)}
            </Text>
          </SidebarNavItem>
        </div>
      ))}
    </div>
  );
}
