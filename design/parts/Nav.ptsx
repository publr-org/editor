// The left panel, "Styles": the builder's pages grouped as the system is layered
// (library, semantic layer, defaults, system), Settings at the foot. Pages with a list
// of their own (primitive blocks, patterns, templates) slide it in with a way back.
import { Publr } from "publr-jsx";
import { Button } from "../../../ui/src/components/Button/Button.ptsx";
import { Icon } from "../../../ui/src/components/Icon/Icon.ptsx";
import type { IconName } from "../../../ui/src/components/Icon/Icon.ptsx";
import { SidebarNavEyebrow } from "../../../ui/src/components/Sidebar/SidebarNavEyebrow.ptsx";
import { SidebarNavItem } from "../../../ui/src/components/Sidebar/SidebarNavItem.ptsx";
import { Text } from "../../../ui/src/components/Text/Text.ptsx";
import { open, openHome, openMoodboard, state } from "../Builder.ptsx";
import type { Page } from "../state";
import { BlocksNav } from "../library/Blocks.ptsx";
import { PatternsNav } from "../library/Patterns.ptsx";
import { TemplatesNav } from "../library/Templates.ptsx";

function Group({ label, children }: { label: string; children?: JSX.Element }) {
  return (
    <div>
      <SidebarNavEyebrow>{label}</SidebarNavEyebrow>
      {children}
    </div>
  );
}

// On a phone the list is a drawer: going to a page closes it.
function go(page: Page): void {
  open(page);
  const drawer = document.getElementById("page-sidebar");
  if (drawer?.matches(":popover-open")) drawer.hidePopover();
}

function Row({ label, page, icon }: { label: string; page: Page; icon: IconName }) {
  return (
    <SidebarNavItem active={state.page === page} onClick={() => go(page)}>
      <Icon name={icon} size="sm" classes="shrink-0" />
      <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
        {label}
      </Text>
    </SidebarNavItem>
  );
}

function Home() {
  return (
    <nav class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 pt-2 pb-4" aria-label={Publr.t("Styles")} data-builder-nav>
      <Row label={Publr.t("Overview")} page="overview" icon="sparkles" />
      <SidebarNavItem onClick={() => openMoodboard()}>
        <Icon name="moodboard" size="sm" classes="shrink-0" />
        <Text as="span" variant="nav" classes="min-w-0 flex-1 truncate">
          {Publr.t("Moodboard")}
        </Text>
        <Icon name="arrow-up-right" size="xs" classes="shrink-0" />
      </SidebarNavItem>
      <Group label={Publr.t("Library")}>
        <Row label={Publr.t("Token library")} page="advanced" icon="token-library" />
        <Row label={Publr.t("Fonts")} page="fonts" icon="fonts-icons" />
        <Row label={Publr.t("Icons")} page="icons" icon="icon" />
        <Row label={Publr.t("Container sizes")} page="containers" icon="container-sizes" />
      </Group>
      <Group label={Publr.t("Semantic layer")}>
        <Row label={Publr.t("Semantic colors")} page="foundations" icon="semantic-colors" />
        <Row label={Publr.t("Typography")} page="typography" icon="element-typography" />
        <Row label={Publr.t("Type scale")} page="type-scale" icon="scale-bars" />
      </Group>
      <Group label={Publr.t("Defaults")}>
        <Row label={Publr.t("Primitive blocks")} page="components" icon="primitive-blocks" />
      </Group>
      <Group label={Publr.t("System")}>
        <Row label={Publr.t("Breakpoints")} page="breakpoints" icon="responsive" />
        <Row label={Publr.t("Patterns")} page="patterns" icon="pattern-library" />
        <Row label={Publr.t("Templates")} page="templates" icon="layout-rows" />
      </Group>
    </nav>
  );
}

function SectionHead() {
  return (
    <div class="flex shrink-0 items-start gap-2 border-b border-sidebar-border px-3 py-3" data-builder-section-head>
      <Button hierarchy="secondary" size="sm" label={Publr.t("Back to styles")} onClick={() => openHome()}>
        <Icon name="chevron-left" size="sm" />
      </Button>
      <div class="min-w-0 pt-0.5">
        <Text as="h3" variant="heading-2xs">
          {state.page === "components" ? Publr.t("Primitive blocks") : state.page === "patterns" ? Publr.t("Patterns") : Publr.t("Templates")}
        </Text>
        <Text as="p" variant="body-2xs" tone="muted" classes="mt-1">
          {state.page === "components" ? Publr.t("Set the starting recipe for each content block.") : state.page === "patterns" ? Publr.t("Review and govern reusable compositions.") : Publr.t("Edit the structure of each content type and the parts they share.")}
        </Text>
      </div>
    </div>
  );
}

export function Nav() {
  return (
    <aside
      class="flex w-60 shrink-0 flex-col overflow-hidden border-r border-sidebar-border bg-card text-sidebar-foreground max-md:w-full max-md:border-r-0"
      aria-label={Publr.t("Styles")}
      data-design-styles-panel
      data-page-sidebar
    >
      <div class="relative flex h-14 shrink-0 items-center gap-2.5 border-b border-sidebar-border px-5">
        <Icon name="palette" size="sm" classes="shrink-0" />
        <Text as="h2" variant="heading-sm" classes="truncate">
          {Publr.t("Styles")}
        </Text>
        <Button
          type="button"
          hierarchy="tertiary"
          size="sm"
          label={Publr.t("Show {name}", { name: Publr.t("Styles") })}
          title={Publr.t("Show {name}", { name: Publr.t("Styles") })}
          popovertarget="page-sidebar"
          classes="absolute top-3 right-3 md:hidden"
        >
          <Icon name="filter-lines" size="sm" />
        </Button>
      </div>
      <div id="page-sidebar" popover="auto" class="flex min-h-0 flex-1 flex-col">
        {state.home && <Home />}
        {!state.home && (
          <div class="flex min-h-0 flex-1 flex-col" data-design-styles-section>
            <SectionHead />
            {state.page === "components" && <BlocksNav />}
            {state.page === "patterns" && <PatternsNav />}
            {state.page === "templates" && <TemplatesNav />}
          </div>
        )}
        {state.home && (
          <div class="shrink-0 border-t border-sidebar-border px-3 py-2">
            <Row label={Publr.t("Settings")} page="settings" icon="settings" />
          </div>
        )}
      </div>
    </aside>
  );
}
