// A compare surface's label: the device as a coloured chip, the breakpoint and its range,
// and which surface is live.
import { Publr } from "publr-jsx";
import { Icon } from "../../ui/src/components/Icon/Icon.ptsx";
import { Text } from "../../ui/src/components/Text/Text.ptsx";

const SURFACE_TONES: Record<string, string> = {
  "Mobile": "bg-[oklch(0.65_0.17_155/0.14)] text-[oklch(0.65_0.17_155)]",
  "Tablet": "bg-[oklch(0.72_0.16_70/0.14)] text-[oklch(0.72_0.16_70)]",
  "Desktop": "bg-[oklch(0.62_0.16_250/0.14)] text-[oklch(0.62_0.16_250)]",
};

/** A compare surface's label: the device, the breakpoint and its range, and which is live. */
export function SurfaceLabel(props: { icon: string; device: string; breakpoint: string; range: string; live: boolean }) {
  return (
    <header class="flex h-[34px] w-full items-center gap-[7px] rounded-t-lg border border-b-0 border-border bg-background px-2.5 shadow-[0_5px_18px_rgb(0_0_0/0.08)]">
      <span class={["inline-flex items-center gap-1 rounded-full py-[3px] pr-[7px] pl-[5px]", SURFACE_TONES[props.device]]}>
        <Icon name={props.icon as never} size="xs" />
        <Text variant="overline">{props.device}</Text>
      </span>
      <Text variant="label-sm-strong">{props.breakpoint}</Text>
      <Text variant="label-2xs-strong" tone="muted" classes="tabular-nums">
        {props.range}
      </Text>
      <span class="ml-auto rounded-full bg-[color-mix(in_oklch,var(--ring)_12%,var(--background))] px-1.5 py-1 text-primary">
        <Text variant="overline">{props.live ? Publr.t("Editing") : Publr.t("Click to edit")}</Text>
      </span>
    </header>
  );
}
