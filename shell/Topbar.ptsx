// The top bar, in three columns so the centered viewport switcher is never crowded: the
// Publr mark, the inserter, history and the list view on the left; the canvas viewport in
// the middle; the sidebar, the other apps, the preview and the options on the right.
// While a template, a part or a pattern is edited on its own, the bar takes the mode's
// colour, names what is edited, and carries Cancel and the commit. On a phone the screen
// is the viewport: one row of the tools, without the switcher and the other apps' links.
import { Publr } from "publr-jsx";
import { DropdownMenu } from "../../ui/src/components/Dropdown/Dropdown.ptsx";
import { DropdownMenuCheckboxItem } from "../../ui/src/components/Dropdown/DropdownMenuCheckboxItem.ptsx";
import { DropdownMenuContent } from "../../ui/src/components/Dropdown/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "../../ui/src/components/Dropdown/DropdownMenuItem.ptsx";
import { DropdownMenuSeparator } from "../../ui/src/components/Dropdown/DropdownMenuSeparator.ptsx";
import { DropdownMenuTrigger } from "../../ui/src/components/Dropdown/DropdownMenuTrigger.ptsx";
import { Icon } from "../../ui/src/components/Icon/Icon.ptsx";
import { Text } from "../../ui/src/components/Text/Text.ptsx";
import { ToolbarButton } from "../../ui/src/components/Toolbar/ToolbarButton.ptsx";
import { ToolbarSegment } from "../../ui/src/components/Toolbar/ToolbarSegment.ptsx";
import { ToolbarSegments } from "../../ui/src/components/Toolbar/ToolbarSegments.ptsx";
import { PublrMark } from "../moodboard/PublrMark.ptsx";
import {
  applyIsolation,
  cancelIsolation,
  copyHtml,
  openApp,
  plusButton,
  preview,
  redo,
  setDevice,
  setLanguage,
  state,
  toggleAppearance,
  toggleCompare,
  toggleFit,
  toggleLeft,
  toggleOutput,
  toggleSidebar,
  undo,
} from "./Shell.ptsx";

const MODE_FILL: Record<string, string> = {
  "": "border-b border-border bg-background px-3",
  template: "bg-[#0f766e] text-white",
  part: "bg-[#581c87] text-white",
  copy: "bg-[#285ae1] text-white",
  definition: "bg-[#285ae1] text-white",
};

export function Topbar() {
  return (
    <header
      data-topbar
      class={["relative grid h-12 shrink-0 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center max-md:flex max-md:justify-between", MODE_FILL[state.isolation?.kind ?? ""]]}
    >
      <div class="flex min-w-0 items-center gap-0.5 justify-self-start">
        <span class="contents max-md:hidden">
          <PublrMark />
        </span>
        <span ref={plusButton} class="contents">
          <ToolbarButton
            variant="primary"
            tone={state.isolation ? "inverse" : "default"}
            title={Publr.t("Block inserter")}
            label={Publr.t("Toggle block inserter")}
            expanded={state.left === "inserter"}
            onClick={() => toggleLeft("inserter")}
          >
            <Icon name={state.left === "inserter" ? "x-close" : "plus"} size="md" />
          </ToolbarButton>
        </span>
        <ToolbarButton tone={state.isolation ? "inverse" : "default"} title={Publr.t("Undo (⌘Z)")} label={Publr.t("Undo")} disabled={!state.canUndo} onClick={() => undo()}>
          <Icon name="undo" size="sm" />
        </ToolbarButton>
        <ToolbarButton tone={state.isolation ? "inverse" : "default"} title={Publr.t("Redo (⇧⌘Z)")} label={Publr.t("Redo")} disabled={!state.canRedo} onClick={() => redo()}>
          <Icon name="redo" size="sm" />
        </ToolbarButton>
        <ToolbarButton tone={state.isolation ? "inverse" : "default"} title={Publr.t("List view")} label={Publr.t("Toggle list view")} pressed={state.left === "list"} onClick={() => toggleLeft("list")}>
          <Icon name="list-view" size="sm" />
        </ToolbarButton>
        {state.isolation && (
          <div data-scope class="ml-2 flex min-w-0 items-center gap-2 border-l border-white/35 pl-3">
            <Text variant="label-lg" classes="shrink-0">
              {state.isolation?.lead}
            </Text>
            <span class="min-w-0 truncate" title={state.isolation?.note}>
              <Text variant="heading-xs">
                <span data-isolation-title>{state.isolation?.label}</span>
              </Text>
            </span>
            {state.isolation?.error && (
              <span data-isolation-error role="alert" class="min-w-0 truncate text-[#ffd9d9]">
                <Text variant="body-sm">{state.isolation?.error}</Text>
              </span>
            )}
          </div>
        )}
      </div>
      <ToolbarSegments label={Publr.t("Canvas viewport")} tone={state.isolation ? "inverse" : "default"} classes="justify-self-center max-md:hidden">
        <ToolbarSegment tone={state.isolation ? "inverse" : "default"} label={Publr.t("Mobile")} icon="device-mobile" pressed={state.device === "mobile"} value={state.deviceLabel} onClick={() => setDevice("mobile")} />
        <ToolbarSegment tone={state.isolation ? "inverse" : "default"} label={Publr.t("Tablet")} icon="device-tablet" pressed={state.device === "tablet"} value={state.deviceLabel} onClick={() => setDevice("tablet")} />
        <ToolbarSegment tone={state.isolation ? "inverse" : "default"} label={Publr.t("Desktop")} icon="device-desktop" pressed={state.device === "desktop"} value={state.deviceLabel} onClick={() => setDevice("desktop")} />
        <ToolbarSegment tone={state.isolation ? "inverse" : "default"} label={Publr.t("Fit viewport to canvas")} icon="viewport-fit" pressed={state.fit} disabled={state.compare} onClick={() => toggleFit()} />
        <ToolbarSegment tone={state.isolation ? "inverse" : "default"} label={Publr.t("Compare all breakpoints")} icon="viewport-compare" pressed={state.compare} onClick={() => toggleCompare()} />
      </ToolbarSegments>
      <div class="flex h-full items-center gap-0.5 justify-self-end">
        {!state.isolation && state.document.languages.length > 1 && (
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <ToolbarButton title={Publr.t("Language")} label={Publr.t("Language")}>
                <Text variant="label-md">{state.document.languageLabel}</Text>
              </ToolbarButton>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="right" classes="min-w-40">
              {state.document.languages.map((language) => (
                <DropdownMenuItem onClick={() => setLanguage(language.code)}>{language.label}</DropdownMenuItem>
              ))}
            </DropdownMenuContent>
          </DropdownMenu>
        )}
        <ToolbarButton tone={state.isolation ? "inverse" : "default"} title={Publr.t("Settings sidebar")} label={Publr.t("Toggle settings sidebar")} pressed={state.sidebarOpen} onClick={() => toggleSidebar()}>
          <Icon name="sidebar-right" size="sm" />
        </ToolbarButton>
        {!state.isolation && state.hasDesign && (
          <ToolbarButton title={Publr.t("Design system")} label={Publr.t("Open design system")} classes="max-md:hidden" onClick={() => openApp("design")}>
            <Icon name="palette" size="sm" />
          </ToolbarButton>
        )}
        {!state.isolation && state.hasMoodboard && (
          <ToolbarButton title={Publr.t("Moodboard")} label={Publr.t("Open moodboard")} classes="max-md:hidden" onClick={() => openApp("moodboard")}>
            <Icon name="moodboard" size="sm" />
          </ToolbarButton>
        )}
        {!state.isolation && (
          <ToolbarButton title={Publr.t("Preview in new tab")} label={Publr.t("Preview in new tab")} onClick={() => preview()}>
            <Icon name="external" size="sm" />
          </ToolbarButton>
        )}
        {!state.isolation && (
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <ToolbarButton title={Publr.t("Options")} label={Publr.t("Options")}>
                <Icon name="more" size="sm" />
              </ToolbarButton>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="right" classes="min-w-52">
              <Text variant="label-md-strong" tone="muted" classes="block px-2 py-1.5">
                {Publr.t("Tools")}
              </Text>
              <DropdownMenuItem onClick={() => toggleOutput()}>{state.output ? Publr.t("Hide wire output") : Publr.t("Show wire output")}</DropdownMenuItem>
              <DropdownMenuItem onClick={() => copyHtml("editing")}>{Publr.t("Copy editing HTML")}</DropdownMenuItem>
              <DropdownMenuItem onClick={() => copyHtml("data")}>{Publr.t("Copy data HTML")}</DropdownMenuItem>
              <DropdownMenuSeparator />
              <span class="contents" onClick={() => toggleAppearance()}>
                <DropdownMenuCheckboxItem checked={!state.dark}>
                  <Icon name="sun" size="sm" />
                  <Text variant="body-md">{Publr.t("Light mode")}</Text>
                </DropdownMenuCheckboxItem>
              </span>
            </DropdownMenuContent>
          </DropdownMenu>
        )}
        {state.isolation && (
          <div data-isolation class="ml-1 flex h-12 shrink-0 items-center gap-1 pr-1">
            <ToolbarButton variant="text" tone="inverse" onClick={() => cancelIsolation()}>
              {Publr.t("Cancel")}
            </ToolbarButton>
            <ToolbarButton
              variant={state.isolation?.kind === "copy" || state.isolation?.kind === "definition" ? "commit-light" : "commit"}
              tone="inverse"
              onClick={() => applyIsolation()}
            >
              <span data-isolation-save>{state.isolation?.save}</span>
            </ToolbarButton>
          </div>
        )}
      </div>
    </header>
  );
}
