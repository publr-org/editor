// The manual tests: every spec in tests/manual, its checks to tick, and its fixture
// loaded into a pristine editor with the spec's policy and theme. `?fixture=<key>` opens
// one test; the same URL is shareable in a report.
import { Publr } from "publr-jsx";
import { Text } from "../../ui/src/components/Text/Text.ptsx";
import { EditorShell } from "../shell/Shell.ptsx";
import type { Session } from "../shell/session";
import { canvasStylesheet, siteStyles } from "./chrome";
import { DEMO_TEXT_STYLES, DEMO_THEME, themeFrom } from "./demo-theme";
import { stampedDocument } from "./home-patterns";
import { HEARTH_THEME } from "./hearth";

// The fixtures' theme: the demo's scales, and the Hearth site's colours and fonts its
// header and footer parts are drawn with.
const FIXTURE_THEME = [...DEMO_THEME, ...HEARTH_THEME.filter((token) => !DEMO_THEME.some((own) => own.name === token.name))];
import { demoTemplates } from "./templates";

export type ManualTest = { key: string; group: string; title: string; intro: string; wide: boolean; checks: string[]; fixture: string; policy: string; theme: string };

const STORAGE = "publr-editor.manual";

function readTicks(): Record<string, boolean> {
  try {
    return JSON.parse(localStorage.getItem(STORAGE) ?? "{}");
  } catch {
    return {};
  }
}

/** The ticked checks, by test and index, as the browser keeps them. */
export const state = Publr.reactive({ ticks: readTicks() });

function tick(key: string, on: boolean): void {
  state.ticks = { ...state.ticks, [key]: on };
  try {
    localStorage.setItem(STORAGE, JSON.stringify(state.ticks));
  } catch {
    // Ticks are a convenience; the harness works without them.
  }
}

function fenceOf(test: ManualTest | undefined): Record<string, unknown> | undefined {
  if (!test?.policy.trim()) return undefined;
  try {
    return JSON.parse(test.policy);
  } catch {
    return undefined;
  }
}

/** A `json` fence is the editor's policy, except one naming `patterns`: the document is their stamps. */
function policyOf(test: ManualTest | undefined) {
  const fence = fenceOf(test);
  return fence && !("patterns" in fence) ? fence : undefined;
}

function contentOf(test: ManualTest): string {
  const fence = fenceOf(test);
  return fence && Array.isArray(fence.patterns) ? stampedDocument(fence.patterns as string[]) : test.fixture;
}

export type ManualProps = { tests: ManualTest[]; selected: string };

export function Manual({ tests, selected }: ManualProps) {
  const test = tests.find((candidate) => candidate.key === selected);
  return (
    <div class="flex h-screen">
      <nav data-manual-list class="w-72 shrink-0 overflow-auto border-r border-border bg-card p-3">
        <Text variant="heading-sm">Manual tests</Text>
        <ol class="mt-3 grid gap-0.5">
          {tests.map((entry) => (
            <li>
              <a
                href={`?fixture=${entry.key}`}
                data-manual={entry.key}
                aria-current={entry.key === selected ? "page" : undefined}
                class="block rounded-md px-2 py-1 text-body-sm hover:bg-ui-accent aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
              >
                <span class="text-2xs opacity-60">{entry.group}</span> {entry.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      {test ? (
        <div class="flex min-w-0 flex-1 flex-col">
          <section data-manual-checks class="max-h-[40vh] shrink-0 overflow-auto border-b border-border bg-card p-4">
            <Text variant="heading-md">{test.title}</Text>
            <p class="mt-1 max-w-3xl text-body-sm text-muted-foreground">{test.intro}</p>
            <ul class="mt-3 grid gap-1">
              {test.checks.map((check, index) => (
                <li>
                  <label class="flex gap-2 text-body-sm">
                    <input type="checkbox" checked={state.ticks[`${test.key}:${index}`] === true} onChange={(event: Event) => tick(`${test.key}:${index}`, (event.target as HTMLInputElement).checked)} />
                    <span>{check}</span>
                  </label>
                </li>
              ))}
            </ul>
          </section>
          <div class="min-h-0 flex-1">
            <EditorShell
              content={contentOf(test)}
              policy={policyOf(test)}
              theme={themeFrom(test.theme) ?? FIXTURE_THEME}
              textStyles={DEMO_TEXT_STYLES}
              canvasStylesheet={canvasStylesheet}
              templates={demoTemplates(() => test.title, "page")}
              siteStyles={siteStyles}
              onReady={(session: Session) => ((window as unknown as { editorSession: Session }).editorSession = session)}
            />
          </div>
        </div>
      ) : (
        <div class="p-8 text-muted-foreground">Pick a test.</div>
      )}
    </div>
  );
}
